# Prevent caching of index.html to ensure users always get the latest build hashes without forcing manual cache clear
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Cache-control for hashed static assets generated by Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable
